<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("invoice_title", "Invoice"), variant: :h1) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<p><%= @presenter.invoice.total_minor %> <%= @presenter.invoice.currency_code %></p>
<p><%= @presenter.invoice.state %></p>
<% if @presenter.command_state.present? %><p>Command status: <%= @presenter.command_state.humanize %></p><% end %>
<%= render FlatPack::List::Component.new do %>
  <% @presenter.invoice.lines.each do |line| %><li><%= line.description %>: <%= line.quantity %> x <%= line.amount_minor %> <%= line.currency_code %><% if line.safe_snapshot.present? %><br>Tax/Overage: <%= @presenter.display_value(line.safe_snapshot) %><% end %></li><% end %>
<% end %>
<% if @presenter.snapshot_rows.present? %>
  <%= render FlatPack::List::Component.new do %>
    <% @presenter.snapshot_rows.each do |label, value| %><li><%= label %>: <%= value %></li><% end %>
  <% end %>
<% end %>
<% if @presenter.financial_rows.present? %>
  <%= render FlatPack::List::Component.new do %>
    <% @presenter.financial_rows.each do |row| %><li><%= row %></li><% end %>
  <% end %>
<% end %>
<%= render FlatPack::Button::Component.new(text: @presenter.copy("invoice_download", "Download invoice"), style: :secondary, size: :md, url: helpers.download_invoice_path(@presenter.invoice, root_recording_id: @presenter.root_recording.id)) %>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:invoice).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>