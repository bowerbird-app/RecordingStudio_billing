<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("usage_title", "Usage"), variant: :h1) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% if @presenter.credit_rows.any? %>
  <%= render FlatPack::List::Component.new do %>
    <% @presenter.credit_rows.each do |label, balance| %><li><%= label %>: <%= balance %></li><% end %>
  <% end %>
<% end %>
<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("usage_periods_title", "Usage this period"), variant: :h2) %>
<%= render FlatPack::List::Component.new do %>
  <% @presenter.period_rows.each do |period| %>
    <li><strong><%= period[:usage_key] %></strong>: <%= period[:window] %> (<%= period[:state] %>)
      <% if period[:included].present? %><br><%= period[:included] %><% end %>
    </li>
  <% end %>
<% end %>
<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("usage_credits_title", "Prepaid credits"), variant: :h2) %>
<%= render FlatPack::List::Component.new do %>
  <% @presenter.grant_rows.each do |grant| %><li><%= grant[:key] %>: <%= grant[:available] %> available of <%= grant[:quantity] %>; <%= grant[:expires_at] %></li><% end %>
<% end %>
<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("usage_charges_title", "Usage charges"), variant: :h2) %>
<%= render FlatPack::List::Component.new do %>
  <% @presenter.allocation_rows.each do |allocation| %>
    <li><%= allocation[:key] %>: <%= allocation[:measured] %> used, <%= allocation[:credited] %> covered by credits, <%= allocation[:excess] %> extra (<%= allocation[:state] %>)
      <% if allocation[:prepaid].positive? %><br><%= @presenter.copy("usage_prepaid", "From prepaid credits") %>: <%= allocation[:prepaid] %><% end %>
      <% if allocation[:extra_usage].present? %><br><%= @presenter.copy("usage_extra", "Extra usage") %>: <%= allocation[:extra_usage] %><% end %>
    </li>
  <% end %>
<% end %>
<% if @presenter.usage_rows.any? { |_label, value| value.present? } %>
  <%= render FlatPack::List::Component.new do %>
    <% @presenter.usage_rows.each do |label, value| %><% if value.present? %><li><%= label %>: <%= value %></li><% end %><% end %>
  <% end %>
<% end %>
<p><%= @presenter.copy("usage_notice", "Usage is recorded by your workspace. This page is read-only.") %></p>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:usage).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
