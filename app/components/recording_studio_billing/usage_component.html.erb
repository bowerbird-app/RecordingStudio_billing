<%= render FlatPack::PageTitle::Component.new(
  title: @presenter.copy("usage_title", "Usage"),
  subtitle: @presenter.copy("usage_subtitle", "Credits left, included usage, and prepaid packs for this workspace."),
  variant: :h1
) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<div class="flex flex-col gap-6">
  <% if @presenter.meter_rows.any? %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <h3 class="text-lg font-semibold"><%= @presenter.copy("usage_credits_left_title", "Credits left") %></h3>
      <% end %>
      <% card.body do %>
        <div class="flex flex-col gap-6">
          <% @presenter.meter_rows.each do |meter| %>
            <%= render FlatPack::Billing::UsageMeter::Component.new(
              label: meter[:label],
              used: meter[:used],
              limit: meter[:limit],
              unit: nil,
              description: meter[:description]
            ) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <h3 class="text-lg font-semibold"><%= @presenter.copy("usage_periods_title", "Usage this period") %></h3>
    <% end %>
    <% card.body do %>
      <% if @presenter.period_rows.any? %>
        <div class="flex flex-col gap-6">
          <% @presenter.period_rows.each do |period| %>
            <%= render FlatPack::Billing::UsageMeter::Component.new(
              label: period[:usage_key],
              used: period[:used],
              limit: period[:limit],
              unit: period[:unit],
              description: period[:window]
            ) %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-[var(--surface-muted-content-color)]"><%= @presenter.copy("usage_no_periods", "No usage has been recorded this period.") %></p>
      <% end %>
    <% end %>
  <% end %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <h3 class="text-lg font-semibold"><%= @presenter.copy("usage_credits_title", "Prepaid credits") %></h3>
    <% end %>
    <% card.body do %>
      <% if @presenter.grant_rows.any? %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <% @presenter.grant_rows.each do |grant| %>
            <%= render FlatPack::List::Item.new(leading: grant[:key], trailing: grant[:expires_at]) do %>
              <%= grant[:available] %> of <%= grant[:quantity] %> available
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-[var(--surface-muted-content-color)]"><%= @presenter.copy("usage_no_credits", "No prepaid credits yet.") %></p>
      <% end %>
    <% end %>
  <% end %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <h3 class="text-lg font-semibold"><%= @presenter.copy("usage_charges_title", "Usage charges") %></h3>
    <% end %>
    <% card.body do %>
      <% if @presenter.allocation_rows.any? %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <% @presenter.allocation_rows.each do |allocation| %>
            <%= render FlatPack::List::Item.new(
              leading: allocation[:key],
              trailing: render(FlatPack::Badge::Component.new(text: allocation[:state], style: status_badge_style(allocation[:state]), size: :sm))
            ) do %>
              <div class="flex flex-col gap-1">
                <span><%= allocation[:measured] %> used, <%= allocation[:credited] %> covered by credits, <%= allocation[:excess] %> extra</span>
                <% if allocation[:prepaid].positive? %>
                  <span class="text-sm text-[var(--surface-muted-content-color)]"><%= @presenter.copy("usage_prepaid", "From prepaid credits") %>: <%= allocation[:prepaid] %></span>
                <% end %>
                <% if allocation[:extra_usage].present? %>
                  <span class="text-sm text-[var(--surface-muted-content-color)]"><%= @presenter.copy("usage_extra", "Extra usage") %>: <%= allocation[:extra_usage] %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-[var(--surface-muted-content-color)]"><%= @presenter.copy("usage_no_charges", "No extra usage charges this period.") %></p>
      <% end %>
    <% end %>
  <% end %>
  <% if @presenter.included_rows.any? %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <h3 class="text-lg font-semibold"><%= @presenter.copy("usage_included_title", "On this plan") %></h3>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <% @presenter.included_rows.each do |row| %>
            <%= render FlatPack::List::Item.new(leading: row[:label], trailing: row[:value]) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render FlatPack::Billing::StatusAlert::Component.new(
    style: :info,
    description: @presenter.copy("usage_notice", "Usage is recorded by your workspace. This page is read-only.")
  ) %>
</div>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:usage).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
