<% if @presenter.result? %>
	<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("subscription_change_result_title", "Plan change"), variant: :h1) %>
	<p><%= @presenter.change_kind_label(@presenter.intent.change_kind) %>: <%= @presenter.money_state(@presenter.intent.state) %></p>
	<%= render FlatPack::List::Component.new do %>
		<li><%= @presenter.copy("change_effective", "Effective") %>: <%= @presenter.effective_description %></li>
		<li><%= @presenter.result_notice %></li>
	<% end %>
<% elsif @presenter.selection? %>
	<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("subscription_change_select_title", "Change plan"), variant: :h1) %>
	<% @presenter.eligible_options.each do |option| %>
		<% change_kinds = @presenter.change_kinds_for(option) %>
		<% next if change_kinds.empty? %>
		<%= form_with url: helpers.compare_change_subscription_path(@presenter.subscription, root_recording_id: @presenter.root_recording.id), method: :post do %>
			<p><%= @presenter.catalog_offer_label(option) %></p>
			<%= hidden_field_tag "subscription_change[billing_option_recording_id]", option.recording.id %>
			<%= label_tag "subscription_change_change_kind", @presenter.copy("change_kind_label", "Change") %>
			<%= select_tag "subscription_change[change_kind]", options_for_select(change_kinds.map { |kind| [@presenter.change_kind_label(kind), kind] }), id: "subscription_change_change_kind" %>
			<%= label_tag "subscription_change_quantity", @presenter.copy("quantity_label", "Quantity") %>
			<%= number_field_tag "subscription_change[quantity]", option.default_quantity, min: option.minimum_quantity, max: option.maximum_quantity, id: "subscription_change_quantity" %>
			<%= render FlatPack::Button::Component.new(text: @presenter.copy("change_compare", "Compare"), style: :primary, size: :md, type: :submit) %>
		<% end %>
	<% end %>
<% elsif @presenter.proposal %>
	<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("subscription_change_compare_title", "Review plan change"), variant: :h1) %>
	<%= render FlatPack::List::Component.new do %>
		<% @presenter.current_terms.each do |term| %><li><%= @presenter.copy("change_current", "Current") %> <%= term[:label] %>: <%= term[:quantity] %> x <%= term[:amount] %> <%= term[:cadence] %></li><% end %>
		<li><%= @presenter.copy("change_proposed", "Proposed") %>: <%= @presenter.proposed_terms[:label] %> <%= @presenter.proposed_terms[:quantity] %> x <%= @presenter.proposed_terms[:amount] %> <%= @presenter.proposed_terms[:cadence] %></li>
		<li><%= @presenter.copy("change_effective", "Effective") %>: <%= @presenter.effective_description %></li>
		<li><%= @presenter.result_notice %></li>
	<% end %>
	<%= form_with url: helpers.confirm_change_subscription_path(@presenter.subscription, root_recording_id: @presenter.root_recording.id), method: :post do %>
		<%= hidden_field_tag "subscription_change[proposal_key]", @presenter.request_key %>
		<%= render FlatPack::Button::Component.new(text: @presenter.copy("change_confirm", "Confirm change"), style: :primary, size: :md, type: :submit) %>
	<% end %>
<% else %>
	<%= render FlatPack::PageTitle::Component.new(title: @presenter.cancellation? ? @presenter.copy("cancel_title", "Cancel plan") : @presenter.copy("resume_title", "Resume plan"), variant: :h1) %>
	<p><%= @presenter.cancellation? ? @presenter.copy("cancel_notice", "Your plan remains available until this cancellation is confirmed.") : @presenter.copy("resume_notice", "Your plan resumes only after this request is confirmed.") %></p>
	<p><%= @presenter.copy("change_effective", "Effective") %>: <%= @presenter.effective_description %>. <%= @presenter.result_notice %></p>
	<%= button_to @presenter.cancellation? ? @presenter.copy("cancel_confirm", "Confirm cancellation") : @presenter.copy("resume_confirm", "Confirm resumption"), @presenter.cancellation? ? helpers.cancel_subscription_path(@presenter.subscription, root_recording_id: @presenter.root_recording.id) : helpers.resume_subscription_path(@presenter.subscription, root_recording_id: @presenter.root_recording.id), method: :post %>
	<%= link_to @presenter.cancellation? ? @presenter.copy("cancel_keep", "Keep plan") : @presenter.copy("resume_keep", "Keep plan paused"), helpers.plan_billing_path(root_recording_id: @presenter.root_recording.id) %>
<% end %>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:subscriptions).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
