<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("plan_title", "Plan"), variant: :h1) %>
<%= render RecordingStudioBilling::BillingNavigationComponent.new(presenter: @presenter, current_page: :subscriptions) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<%= render FlatPack::List::Component.new do %>
  <% @presenter.subscriptions.each do |subscription| %>
    <li>
      <strong><%= @presenter.subscription_label(subscription) %></strong>: <%= @presenter.money_state(subscription.state) %>
      <% @presenter.current_subscription_rows(subscription).each do |item| %>
        <%= render FlatPack::List::Component.new do %>
          <li><%= item[:label] %>: <%= item[:quantity] %> x <%= item[:amount] %> <%= item[:cadence] %></li>
        <% end %>
      <% end %>
      <%= link_to @presenter.copy("change_subscription", "Change plan"), helpers.change_selection_subscription_path(subscription, root_recording_id: @presenter.root_recording.id) %>
      <% if subscription.state.in?(%w[trialing active past_due paused]) %>
        <%= link_to @presenter.copy("cancel_subscription", "Cancel plan"), helpers.cancel_confirmation_subscription_path(subscription, root_recording_id: @presenter.root_recording.id) %>
      <% end %>
      <% if subscription.state == "paused" %>
        <%= link_to @presenter.copy("resume_subscription", "Resume plan"), helpers.resume_confirmation_subscription_path(subscription, root_recording_id: @presenter.root_recording.id) %>
      <% end %>
    </li>
  <% end %>
<% end %>
<% if @presenter.eligible_options.present? %>
  <%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("choose_plan_title", "Choose a plan"), variant: :h2) %>
  <% @presenter.eligible_options.each do |option| %>
    <%= form_with url: helpers.checkout_billing_path(root_recording_id: @presenter.root_recording.id), method: :post do %>
      <p><%= @presenter.offer_summary(option) %></p>
      <%= hidden_field_tag :checkout_request_key, SecureRandom.hex(16) %>
      <%= hidden_field_tag "items[0][billing_option_recording_id]", option.recording.id %>
      <% if option.quantity_mode == "adjustable" %>
        <%= label_tag "items_0_quantity", @presenter.copy("quantity_label", "Quantity") %>
        <%= number_field_tag "items[0][quantity]", option.default_quantity, min: option.minimum_quantity, max: option.maximum_quantity, id: "items_0_quantity" %>
      <% end %>
      <%= render FlatPack::Button::Component.new(text: @presenter.copy("choose_plan_continue", "Continue to checkout"), style: :primary, size: :md, type: :submit) %>
    <% end %>
  <% end %>
<% end %>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:subscriptions).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
