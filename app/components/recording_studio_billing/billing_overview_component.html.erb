<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("overview_title", "Billing"), variant: :h1) %>
<%= render RecordingStudioBilling::BillingNavigationComponent.new(presenter: @presenter, current_page: :overview) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header { render FlatPack::PageTitle::Component.new(title: @presenter.copy("plan_title", "Plan"), variant: :h2) } %>
  <% card.body do %>
    <% if @presenter.subscription_rows.present? %>
      <%= render FlatPack::List::Component.new do %>
        <% @presenter.subscription_rows.each do |row| %>
          <li>
            <strong><%= row[:label] %></strong>: <%= row[:state] %>
            <% if row[:summary].present? %><br><%= row[:summary] %><% end %>
            <% if row[:current] %>
              <%= link_to @presenter.copy("cancel_subscription", "Cancel plan"), helpers.cancel_confirmation_subscription_path(row[:subscription], root_recording_id: @presenter.root_recording.id) %>
            <% end %>
            <% if row[:subscription].state == "paused" %>
              <%= link_to @presenter.copy("resume_subscription", "Resume plan"), helpers.resume_confirmation_subscription_path(row[:subscription], root_recording_id: @presenter.root_recording.id) %>
            <% end %>
            <br><%= @presenter.copy("change_request_notice", "Cancellation and resumption are requests; the current plan changes only after the provider confirms.") %>
          </li>
        <% end %>
      <% end %>
    <% else %>
      <p><%= @presenter.copy("no_subscriptions", "No active subscription.") %></p>
    <% end %>
  <% end %>
<% end %>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:overview).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
