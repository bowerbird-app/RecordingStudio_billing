<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("settings_title", "Billing settings"), variant: :h1) %>
<%= render RecordingStudioBilling::BillingNavigationComponent.new(presenter: @presenter, current_page: :settings) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<p><%= @presenter.notice %></p>
<%= form_with url: helpers.update_settings_billing_path(root_recording_id: @presenter.root_recording.id), method: :patch do %>
  <%= label_tag "account_name", @presenter.copy("settings_display_name", "Billing display name") %>
  <%= text_field_tag "account[name]", @presenter.account.name, id: "account_name" %>
  <%= label_tag "account_contact_email", @presenter.copy("settings_contact_email", "Contact email") %>
  <%= email_field_tag "account[contact_email]", @presenter.account.contact_email, autocomplete: "email", id: "account_contact_email" %>
  <%= label_tag "account_billing_country_code", @presenter.copy("settings_country", "Billing country") %>
  <%= text_field_tag "account[billing_country_code]", @presenter.account.billing_country_code, maxlength: 2, id: "account_billing_country_code" %>
  <%= label_tag "account_billing_currency_code", @presenter.copy("settings_currency", "Billing currency") %>
  <%= text_field_tag "account[billing_currency_code]", @presenter.account.billing_currency_code, maxlength: 3, id: "account_billing_currency_code" %>
  <%= label_tag "account_locale", @presenter.copy("settings_language", "Language") %>
  <%= text_field_tag "account[locale]", @presenter.account.locale, id: "account_locale" %>
  <%= label_tag "account_time_zone", @presenter.copy("settings_time_zone", "Time zone") %>
  <%= select_tag "account[time_zone]", options_for_select(ActiveSupport::TimeZone.all.map(&:name), @presenter.account.time_zone), include_blank: true, id: "account_time_zone" %>
  <%= label_tag "account_tax_location_country_code", @presenter.copy("settings_tax_country", "Tax country") %>
  <%= text_field_tag "account[tax_location_country_code]", @presenter.account.tax_location_country_code, maxlength: 2, id: "account_tax_location_country_code" %>
  <%= label_tag "account_tax_location_region_code", @presenter.copy("settings_tax_region", "Tax region") %>
  <%= text_field_tag "account[tax_location_region_code]", @presenter.account.tax_location_region_code, id: "account_tax_location_region_code" %>
  <%= label_tag "account_tax_location_postal_code", @presenter.copy("settings_postal_code", "Postal code") %>
  <%= text_field_tag "account[tax_location_postal_code]", @presenter.account.tax_location_postal_code, id: "account_tax_location_postal_code" %>
  <%= render FlatPack::Button::Component.new(text: @presenter.copy("settings_save", "Save settings"), style: :primary, size: :md, type: :submit) %>
<% end %>
<% if @presenter.support_url.present? %>
  <%= render FlatPack::Button::Component.new(text: @presenter.copy("support_label", "Billing support"), style: :secondary, size: :md, url: @presenter.support_url, target: "_blank") %>
<% end %>
<% if RecordingStudioBilling.configuration.billing_portal_context_resolver %>
  <%= button_to @presenter.copy("settings_payment_details", "Manage payment details"), portal_billing_path(root_recording_id: @presenter.root_recording.id), method: :post %>
<% end %>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:settings).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
