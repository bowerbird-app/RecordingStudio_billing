<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("checkout_title", "Checkout"), variant: :h1) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<div class="flex flex-col gap-6">
  <%= render FlatPack::Alert::Component.new(
    description: checkout_status_copy,
    style: checkout_status_style,
    data: { checkout_intent_state: @presenter.checkout_intent.state }
  ) %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% checkout_line_rows.each do |line| %>
          <%= render FlatPack::List::Item.new do %>
            <div class="flex flex-col gap-1">
              <strong><%= line[:label] %></strong>
              <span class="text-sm text-[var(--surface-muted-content-color)]">
                <%= line[:quantity] %> x <%= line[:amount] %><% if line[:cadence].present? %> <%= line[:cadence] %><% end %>
              </span>
              <% if line[:tax].present? %>
                <span class="text-sm text-[var(--surface-muted-content-color)]"><%= line[:tax] %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% if checkout_action_button? %>
      <% card.footer do %>
        <%= render_checkout_action %>
      <% end %>
    <% end %>
  <% end %>
  <% unless checkout_action_button? %>
    <%= render_checkout_action %>
  <% end %>
  <% if (notice = @presenter.checkout_notice).present? %>
    <%= render FlatPack::Alert::Component.new(description: notice, style: :info) %>
  <% end %>
</div>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:checkout).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
