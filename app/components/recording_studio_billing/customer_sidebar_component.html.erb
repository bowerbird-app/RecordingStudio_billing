<%= render FlatPack::Sidebar::Group::Component.new(
  title: "Billing",
  icon: :credit_card,
  open: billing_open?
) do |group| %>
  <% group.items do %>
    <% items.each do |item| %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: item.fetch(:label),
        href: item.fetch(:href),
        icon: item[:icon],
        active: item[:page]&.to_sym == current_page
      ) %>
    <% end %>
  <% end %>
<% end %>
