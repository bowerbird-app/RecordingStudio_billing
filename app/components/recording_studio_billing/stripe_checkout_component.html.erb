<%= render FlatPack::PageTitle::Component.new(title: @presenter.copy("checkout_title", "Checkout"), variant: :h1) %>
<% header_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<p data-checkout-intent-state="<%= @presenter.checkout_intent.state %>"><%= checkout_status_copy %></p>
<%= render FlatPack::List::Component.new do %>
  <% checkout_line_rows.each do |line| %>
    <li>
      <strong><%= line[:label] %></strong>: <%= line[:quantity] %> x <%= line[:amount] %>
      <% if line[:cadence].present? %> <%= line[:cadence] %><% end %>
      <% if line[:tax].present? %><br><%= line[:tax] %><% end %>
    </li>
  <% end %>
<% end %>
<% if embedded_checkout_ready? %>
  <div data-stripe-checkout-client-secret="<%= presentation_value(:client_secret) %>" data-stripe-publishable-key="<%= presentation_value(:publishable_key) %>"></div>
  <p data-stripe-checkout-failure hidden><%= @presenter.copy("checkout_provider_failure", "Secure checkout could not load. Refresh the page or try again shortly.") %></p>
  <%= javascript_include_tag "https://js.stripe.com/v3/" %>
  <%= javascript_include_tag "recording_studio_billing/stripe_checkout", type: "module" %>
<% else %>
  <%= render_checkout_action %>
<% end %>
<p><%= @presenter.copy("checkout_notice", "Your payment is confirmed only after provider reconciliation. Browser completion does not confirm a purchase.") %></p>
<% body_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
<% @presenter.page_contents(:checkout).each { |content| %><%= render_extension(content) %><% } %>
<% footer_extensions.each { |extension| %><%= render_extension(extension) %><% } %>
