<%= form_with url: page.submit_path, method: :post do %>
  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
      <% if select_parent %>
        <%= render FlatPack::Select::Component.new(
              name: "parent_recording_id",
              label: "Product",
              required: true,
              options: page.product_options,
              placeholder: "Select a product"
            ) %>
      <% end %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[name]", value: page.value(:name), label: "Name", required: true
          ) %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[key]", value: page.value(:key), label: "Key", required: true
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[recurrence]", value: page.value(:recurrence), label: "Recurrence", required: true,
            options: RecordingStudioBilling::BillingOption::RECURRENCES.map { |value| [value.humanize, value] },
            placeholder: false
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[interval]", value: page.value(:interval), label: "Interval",
            options: [["None", ""], *RecordingStudioBilling::BillingOption::INTERVALS.map { |value| [value.humanize, value] }],
            placeholder: false
          ) %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[interval_count]", value: page.value(:interval_count), label: "Interval count"
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[pricing_model]", value: page.value(:pricing_model), label: "Pricing model", required: true,
            options: RecordingStudioBilling::BillingOption::PRICING_MODELS.map { |value| [value.humanize, value] },
            placeholder: false
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[collection_method]", value: page.value(:collection_method),
            label: "Collection method", required: true,
            options: RecordingStudioBilling::BillingOption::COLLECTION_METHODS.map { |value| [value.humanize, value] },
            placeholder: false
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[checkout_policy]", value: page.value(:checkout_policy),
            label: "Checkout policy", required: true,
            options: RecordingStudioBilling::BillingOption::CHECKOUT_POLICIES.map { |value| [value.humanize, value] },
            placeholder: false
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[tax_policy]", value: page.value(:tax_policy), label: "Tax policy", required: true,
            options: RecordingStudioBilling::BillingOption::TAX_POLICIES.map { |value| [value.humanize, value] },
            placeholder: false
          ) %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[trial_days]", value: page.value(:trial_days), label: "Trial days", required: true
          ) %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
        <%= render FlatPack::Button::Component.new(text: "Cancel", href: page.cancel_path, style: :secondary) %>
        <%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
