<% billing_page_nav(title: "New product", back_url: @page.cancel_path, back_label: "Products") %>
<% if @page.access_recording.present? && respond_to?(:recording_studio_accessible_avatars) %>
  <% recording_studio_page_nav_right do %>
    <%= recording_studio_accessible_avatars(@page.access_recording, button_style: :ghost, button_size: :md) %>
  <% end %>
<% end %>

<%= render FlatPack::PageTitle::Component.new(title: "New product") %>

<%= form_with url: @page.create_path, method: :post do %>
  <%= hidden_field_tag :parent_recording_id, @page.parent_recording_id %>
  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md, class: "mt-6") do %>
    <div class="space-y-4">
      <%= render FlatPack::TextInput::Component.new(name: "attributes[name]", label: "Name", required: true) %>
      <%= render FlatPack::TextInput::Component.new(name: "attributes[key]", label: "Key", required: true) %>
      <%= render FlatPack::Select::Component.new(name: "attributes[kind]", label: "Kind", required: true,
            options: @page.kind_options, placeholder: false) %>
      <%= render FlatPack::Select::Component.new(name: "attributes[provider_account_recording_id]", label: "Provider",
            required: true, options: @page.provider_options, placeholder: false) %>
      <div class="flex flex-wrap items-center gap-3">
        <%= render FlatPack::Button::Component.new(text: "Cancel", href: @page.cancel_path, style: :secondary) %>
        <%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
      </div>
    </div>
  <% end %>
<% end %>
