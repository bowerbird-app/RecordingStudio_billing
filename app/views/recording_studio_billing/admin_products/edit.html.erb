<% billing_page_nav(title: @page.title, back_url: @page.cancel_path, back_label: "Products") %>
<% recording_studio_page_nav_right do %>
  <%= recording_studio_accessible_avatars(@page.access_recording, button_style: :ghost, button_size: :md) %>
<% end %>

<%= render FlatPack::PageTitle::Component.new(title: @page.title) %>

<%= form_with url: @page.submit_path, method: :post do %>
  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[name]", value: @page.value(:name), label: "Name", required: true
          ) %>
      <%= render FlatPack::TextInput::Component.new(
            name: "attributes[key]", value: @page.value(:key), label: "Key", required: true
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[kind]", value: @page.value(:kind), label: "Kind", required: true,
            options: @page.kind_options, placeholder: false
          ) %>
      <%= render FlatPack::Select::Component.new(
            name: "attributes[provider_account_recording_id]",
            value: @page.value(:provider_account_recording_id),
            label: "Provider",
            required: true,
            options: @page.provider_options,
            placeholder: false
          ) %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
        <%= render FlatPack::Button::Component.new(text: "Cancel", href: @page.cancel_path, style: :secondary) %>
        <%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
