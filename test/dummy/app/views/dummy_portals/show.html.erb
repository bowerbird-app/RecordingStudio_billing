<% dummy_page_nav(title: "Payment details") %>
<%= render FlatPack::PageTitle::Component.new(
  title: "Payment details",
  subtitle: "This portal can update payment methods, billing address, tax IDs, and invoice history. Plan changes stay in billing.",
  variant: :h1
) %>
<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.body do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <%= render FlatPack::List::Item.new do %>Payment methods: card on file is updated here, not by changing a plan.<% end %>
      <%= render FlatPack::List::Item.new do %>Billing address: used for invoices and tax location.<% end %>
      <%= render FlatPack::List::Item.new do %>Tax IDs: business tax numbers for invoices.<% end %>
      <%= render FlatPack::List::Item.new do %>Invoice history: open billing invoices to download statements.<% end %>
    <% end %>
  <% end %>
  <% card.footer do %>
    <%= render FlatPack::Button::Component.new(text: "Back to billing settings", style: :secondary, href: "/billing/settings") %>
  <% end %>
<% end %>
