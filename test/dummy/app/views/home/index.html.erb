<%= render FlatPack::PageTitle::Component.new(
  title: "Recording Studio Billing",
  subtitle: "A provider-agnostic billing foundation with Stripe as the default provider.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Foundation",
          subtitle: "The Recording Studio billing graph is ready for provider adapters.",
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new do %>
          <li>Workspace roots enable the <code>:billing</code> capability.</li>
          <li>Admin roots enable <code>:billing_admin</code> and expose the <code>:billing</code> admin section.</li>
          <li>Billing accounts and billing administration are Recording Studio child recordables.</li>
          <li>PostgreSQL UUIDs, Devise, FlatPack, and Root Switchable remain wired in the host app.</li>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Phase 1 boundary",
          subtitle: "Commercial billing behavior intentionally starts in a later phase.",
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(ordered: true) do %>
          <li>Configure a provider adapter when provider-specific work begins.</li>
          <li>Use <code>RecordingStudioBilling.configure { |config| config.provider = :stripe }</code> to choose the default.</li>
          <li>Keep commercial entities, charges, invoices, and webhooks out of this foundation phase.</li>
          <li>Use the dummy app to validate layout, asset scanning, authentication, and Recording Studio wiring.</li>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "FlatPack usage",
          subtitle: "This page uses FlatPack components for its primary UI structure.",
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <p>
          Use FlatPack cards, buttons, badges, inputs, and layout primitives as the default path for addon UI. Keep raw HTML for simple semantic content only.
        </p>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "View FlatPack documentation",
          style: :primary,
          size: :md,
          url: "https://github.com/bowerbird-app/flatpack",
          target: "_blank"
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Install flow",
          subtitle: "What the host app generator path covers.",
          variant: :h3
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new do %>
          <li>Add the gem to your host app and run <code>bundle install</code>.</li>
          <li>Run <code>rails generate recording_studio_billing:install</code> to mount the engine and add configuration.</li>
          <li>Run <code>rails generate recording_studio_billing:migrations</code> to copy engine migrations into the host app.</li>
          <li>Rebuild Tailwind if needed with <code>bin/rails tailwindcss:build</code>.</li>
        <% end %>
      <% end %>
    <% end %>
<% end %>
