<%= render FlatPack::Grid::Component.new(cols: 1, align: :center) do %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Login",
          variant: :h2
        ) %>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <%= render FlatPack::EmailInput::Component.new(
              name: "user[email]",
              label: "Email",
              value: "admin@admin.com",
              placeholder: "you@example.com"
            ) %>

            <%= render FlatPack::PasswordInput::Component.new(
              name: "user[password]",
              label: "Password",
              value: "Password",
              required: true
            ) %>

            <% if devise_mapping.rememberable? %>
              <%= render FlatPack::Checkbox::Component.new(
                name: "#{resource_name}[remember_me]",
                label: "Remember me"
              ) %>
            <% end %>

            <%= render FlatPack::Button::Component.new(
              text: "Sign In",
              style: :primary,
              size: :md,
              type: "submit"
            ) %>
        <% end %>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Badge::Component.new(
          text: "Default: admin@admin.com / Password",
          style: :info,
          size: :sm
        ) %>
      <% end %>
  <% end %>
<% end %>